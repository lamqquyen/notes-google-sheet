    "tail": "wrangler tail"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.4.5",
    "wrangler": "^3.99.0"
  }
}

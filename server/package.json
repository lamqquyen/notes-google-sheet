{
  "name": "notes-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram + in-app chatbot for the notes (spending/receiving) Google Sheet, runs on Cloudflare Workers.",
  "scripts": {
